# =============================================================================
# PaymentPulse — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit the .env file — it is in .gitignore.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Local DuckDB path (default used if not set)
DUCKDB_PATH=data/paymentpulse.duckdb

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Target architecture — NOT used in local execution ────────────────────────
# These would be populated in a real cloud environment.

# AWS
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-2
# S3_BUCKET=

# Snowflake
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_ROLE=

# Databricks
# DATABRICKS_HOST=
# DATABRICKS_TOKEN=
# DATABRICKS_CLUSTER_ID=
